APP_ENV=local
APP_PORT=8000
APP_TIMEZONE=UTC
APP_DEBUG=true

DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=go_nextjs_dashboard

HASHING_DRIVER=bcrypt

LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=file
LOG_PATH=./logs/app.log

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_SKIP_TLS_VERIFY=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# at least 32 bytes: openssl rand -base64 32
JWT_HMAC_KEY=
